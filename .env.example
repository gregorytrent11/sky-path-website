# Copy this file to .env.local and fill in real values.
# .env.local is gitignored -- never commit real keys.

# Public site
NEXT_PUBLIC_SITE_URL=https://skyspath.com
NEXT_PUBLIC_ORGANIZATION_NAME="Sky's Path to Home"

# Supabase (Project Settings -> API)
# The anon key is safe to expose in the browser; it is enforced by Row-Level
# Security policies in the database, not by secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: NEVER put this in a NEXT_PUBLIC_ variable or in this repo.
# It belongs only in Supabase Edge Function secrets (set via `supabase secrets set`).
# SUPABASE_SERVICE_ROLE_KEY=

# Dog photos/videos are stored in Supabase Storage (buckets: dog-photos,
# dog-videos) -- no separate media provider needed.

# Transactional email (used from Supabase Edge Functions)
# EMAIL_FROM=
# EMAIL_TO=
# EMAIL_PROVIDER_API_KEY=

# Spam protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY= (used from Supabase Edge Functions)

# Donation placeholder -- update once a donation platform is selected
NEXT_PUBLIC_DONATION_URL=

# Optional external application platform links
NEXT_PUBLIC_ADOPT_APPLICATION_URL=
NEXT_PUBLIC_FOSTER_APPLICATION_URL=

# Media limits (also enforced server-side; do not rely on these alone)
MAX_DOG_PHOTOS=10
MAX_DOG_VIDEO_SECONDS=30
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=157286400
